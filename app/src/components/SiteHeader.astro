---
import { SITE } from '../config/region';

const nav = [
  { href: '/#resources', label: 'Find Help' },
  { href: '/lifeline', label: 'Lifeline' },
  { href: '/#how', label: 'How We Verify' },
  { href: '/about', label: 'About' },
  { href: '/grants', label: 'Grants' },
  { href: '/submit', label: 'Suggest a Resource' },
  { href: '/donate', label: 'Donate' },
];
const path = Astro.url.pathname;
---

<header class="no-print sticky top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <span
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-600 text-xl font-bold text-white shadow-sm"
          aria-hidden="true">B</span
        >
        <span class="flex flex-col">
          <span class="text-xl leading-none font-bold tracking-tight text-slate-800">{SITE.name}</span>
          <span class="mt-1 text-[10px] font-semibold tracking-wider text-emerald-600 uppercase"
            >{SITE.domain}</span
          >
        </span>
      </a>

      <nav class="hidden items-center gap-7 text-sm font-medium md:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={
                item.href === path
                  ? 'text-emerald-700'
                  : 'text-slate-600 transition hover:text-emerald-600'
              }
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/#resources"
          class="rounded-full bg-emerald-600 px-4 py-2 text-white transition hover:bg-emerald-700"
        >
          Find Help
        </a>
      </nav>

      <a href="/#resources" class="text-sm font-semibold text-emerald-700 md:hidden">Find Help</a>
    </div>
  </div>
</header>
