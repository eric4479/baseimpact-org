name = "baseimpact-find-help"
compatibility_date = "2026-04-15"

[build]
  command = "npm run build"
  watch_dir = "./src"

[env.production]
  name = "baseimpact-find-help"

[[send_email]]
  binding = "EMAIL"
  address = "info@baseimpact.org"

[[kv_namespaces]]
  binding = "SESSION"

[[images]]
  binding = "IMAGES"

[observability]
  enabled = true
