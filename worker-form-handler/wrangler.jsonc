{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseimpact-form-handler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "baseimpact.org/api/*", "zone_name": "baseimpact.org" }
  ]
}
