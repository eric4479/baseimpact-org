{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseimpact-form-handler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Pinned deliberately. This login has three Cloudflare accounts attached, and
  // without an explicit account_id every wrangler command fails with "More than one
  // account available but unable to select one in non-interactive mode" unless
  // CLOUDFLARE_ACCOUNT_ID is exported first. Pinning it means `wrangler deploy` and
  // `wrangler d1 execute` just work, and cannot be pointed at the wrong account by a
  // stale environment variable. This is Eric@douglaspc.com's account, the one that
  // owns the baseimpact.org zone and the baseimpact-org Pages project.
  "account_id": "7e551880aa7a915a78c9b0887630b621",

  "observability": {
    "enabled": true
  },

  // The referral log. This is the denominator of the connected referral rate, so it
  // is a hard dependency of the /log page and the /api/referrals endpoints.
  "d1_databases": [
    {
      "binding": "REFERRALS",
      "database_name": "baseimpact-referrals",
      "database_id": "b6ce687d-5e9f-4f7b-b58e-c90e56545663"
    }
  ],

  // Private evidence store for photos people send with an outcome.
  //
  // This bucket is deliberately NOT public and has no custom domain. Objects are
  // written by the Worker and read only through an authenticated /log request. The
  // whole point of the "private evidence" decision is that a photo of a neighbour
  // at a food pantry is never a URL anyone can guess or share.
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "baseimpact-referral-evidence"
    }
  ],

  // Cloudflare Email Sending binding.
  //
  // This REPLACES the MailChannels fetch that used to live in the Worker. That API
  // (api.mailchannels.net/v1/send) now returns 404, so every form notification had
  // been failing while the site still told visitors "we'll be in touch".
  //
  // Requires Email Sending to be enabled on the account and the From domain to be a
  // verified sending domain. Until that is done the binding is absent at runtime,
  // sendEmail() returns { sent: false }, and the submission is still written to D1 --
  // the message is never lost, and /api/forms shows it as unread.
  //
  // Set with:  wrangler email sending enable baseimpact.org
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Retention sweep + retry of any notification that failed to send. Daily at 06:00 UTC.
  // Also enforces the 90-day promise made in migrations/0002_form_submissions.sql.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  "routes": [
    { "pattern": "baseimpact.org/api/*", "zone_name": "baseimpact.org" }
  ]
}
