---
import Base from '../layouts/Base.astro';
---

<Base title="Join Us — Base Impact" description="Join Base Impact as a member, volunteer, or partner. Help bring technology help to Brevard County, FL.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Join Us</h1>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed">
    <p>Base Impact is growing, and we want you to be part of it.</p>
    <h2 class="font-display text-xl font-semibold text-body mt-6">Ways to join</h2>
    <ul class="list-disc pl-5 space-y-2">
      <li><strong>Volunteer</strong> — Share your time and skills. See our <a href="/volunteer" class="text-accent font-semibold">volunteer page</a>.</li>
      <li><strong>Partner</strong> — If your organization serves Brevard County, let's work together. See our <a href="/partners" class="text-accent font-semibold">partners page</a>.</li>
      <li><strong>Donate</strong> — Support our mission financially. See <a href="/how-to-help" class="text-accent font-semibold">how to help</a>.</li>
      <li><strong>Spread the word</strong> — Tell neighbors, churches, and community groups about the resource directory.</li>
    </ul>
    <h2 class="font-display text-xl font-semibold text-body mt-6">Stay connected</h2>
    <p>Follow us for updates on new resources, events, and opportunities to get involved.</p>
    <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Contact us</a>
  </div>
</Base>
