---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/region';

export const prerender = true;
---

<Base
  title={`Donate to Base Impact — Help Brevard County Families`}
  description="Support Base Impact's mission to connect Brevard County neighbors with vital resources. Learn about our tax status, registration, and how donations are used."
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-6 text-4xl font-bold text-slate-900 md:text-5xl dark:text-slate-100">Help Us Show Up for Our Community</h1>
    <p class="mb-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Two people on a bike path, living in a tent, walking from Mims to South Carolina. A veteran
      with PTSD whose laptop just died. A new resident who needs someone to sit with them through
      a job application.
    </p>
    <p class="mb-8 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Base Impact is the neighborhood navigation desk — we find the help, connect people to resources,
      and walk alongside them until they're back on their feet. Your donation keeps this going.
    </p>

    <!-- Partner Highlight -->
    <div class="mb-12 rounded-2xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-800 dark:bg-blue-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Working Together</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        We volunteer and partner with <strong>LifePointe Ministries</strong>, <strong>No One Hungry</strong>,
        <strong>Under the Bridge Ministries</strong>, and <strong>Second Harvest Food Bank</strong>
        to help the community in their times of need.
      </p>
    </div>

    <!-- Zeffy Donation Button -->
    <div class="mb-12 rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center dark:border-emerald-800 dark:bg-emerald-950/40">
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        Every dollar helps us maintain and grow our resource network.
      </p>
      <a
        href="https://www.zeffy.com/en-US/peer-to-peer/50k-for-base-impact"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-emerald-800 px-8 py-3 text-lg font-semibold text-white transition hover:bg-emerald-900"
      >
        Donate Now
      </a>
      <p class="mt-3 text-xs text-slate-600 dark:text-slate-300">
        Secure donation through Zeffy. No fees — 100% goes to Base Impact.
      </p>
    </div>

    <!-- Disclaimer -->
    <div class="mb-12 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-relaxed text-amber-900 dark:border-amber-800 dark:text-amber-200 dark:bg-amber-950/40">
      <p class="mb-2 font-bold">Please Note</p>
      <p>
        Base Impact is a navigator, not a provider. We rely on community reports and updates to keep
        our listings current. We do not independently verify every listing and are not liable for
        mistakes, outdated information, or false information. Always call ahead before you travel to
        any listed organization.
      </p>
    </div>

    <!-- Tax Status -->
    <section class="mb-12 rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-800 dark:bg-amber-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Tax Status</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        Base Impact, Inc. is a Florida Not For Profit Corporation. We have filed Form 1023-EZ with
        the IRS to apply for recognition of tax-exempt status under Section 501(c)(3) of the
        Internal Revenue Code. <strong>Until that status is confirmed, donations are NOT tax-deductible.</strong>
      </p>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        Once approved, donations become tax-deductible retroactive to our formation date.
      </p>
    </section>

    <!-- Registration Info -->
    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Registration &amp; Transparency</h2>
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        Base Impact, Inc. is registered with the Florida Department of Agriculture and Consumer
        Services under the Solicitation of Contributions Act.
      </p>
      <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <dl class="space-y-3 text-sm">
          <div class="flex flex-wrap gap-x-2">
            <dt class="font-semibold text-slate-800 dark:text-slate-200">Florida Solicitation of Contributions Registration #:</dt>
            <dd class="text-emerald-800 font-mono dark:text-emerald-400">CH85670</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="font-semibold text-slate-800 dark:text-slate-200">Registration Expires:</dt>
            <dd class="text-slate-700 dark:text-slate-300">October 16, 2027</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="font-semibold text-slate-800 dark:text-slate-200">Employer Identification Number (EIN):</dt>
            <dd class="text-slate-700 font-mono dark:text-slate-300">43-2200667</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="font-semibold text-slate-800 dark:text-slate-200">Sunbiz Document Number:</dt>
            <dd class="text-slate-700 font-mono dark:text-slate-300">N26000013382</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Fiscal Sponsor -->
    <section class="mb-12 rounded-2xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-800 dark:bg-blue-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Grant Funding &amp; Fiscal Sponsorship</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        Base Impact, Inc. is fiscally sponsored by
        <strong>LifePointe Ministries, Inc.</strong> (EIN: 45-1198607), a Florida Not For Profit
        Corporation. Grant applications are submitted under LifePointe Ministries' tax-exempt status,
        allowing us to receive tax-deductible grant funding while we complete our own 501(c)(3)
        application with the IRS.
      </p>
    </section>

    <!-- Donor Privacy -->
    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Donor Privacy</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        We collect only the information needed to process your donation and send a receipt. We never
        sell, rent, or share your personal information with third parties for marketing purposes.
        Payment processing is handled by a secure third-party processor. This site does not store
        payment card information.
      </p>
    </section>

    <!-- Receipt Policy -->
    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Donation Receipts</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        All donations will receive an electronic acknowledgment. Donations of $250 or more will
        receive a written tax acknowledgment via email for your records, as required by the IRS.
      </p>
    </section>

    <!-- How Donations Are Used -->
    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">How Donations Are Used</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        Your donation directly supports our mission to connect Brevard County neighbors with local
        resources. We are committed to financial transparency — the majority of every dollar goes
        directly to programs and services.
      </p>
    </section>

    <!-- Contact -->
    <section>
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Questions?</h2>
      <p class="text-slate-700 dark:text-slate-300">
        <a href={`mailto:${SITE.email}?subject=Donation%20Question`} class="font-semibold text-emerald-800 underline dark:text-emerald-400">
          {SITE.email}
        </a>
      </p>
      <p class="mt-4 text-xs text-slate-600 dark:text-slate-300">
        {SITE.legalNotice}
      </p>
    </section>
  </article>
</Base>
