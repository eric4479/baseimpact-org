---
import Base from '../layouts/Base.astro';
---

<Base title="Donate — Base Impact" description="Support Base Impact's mission to help neighbors get connected in Brevard County, FL.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Donate</h1>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed fade-in">
    <p>Base Impact is a pre-filing nonprofit. Your support helps us provide devices, internet service, digital skills training, and tech support to neighbors and small nonprofits in Brevard County.</p>

    <h2 class="font-display text-xl font-semibold text-body mt-6">What your donation supports</h2>
    <ul class="list-disc pl-5 space-y-2">
      <li><strong>Devices</strong> — Refurbished computers and tablets for neighbors who need them.</li>
      <li><strong>Internet access</strong> — Help with internet service applications and subsidies.</li>
      <li><strong>Training</strong> — One-on-one digital skills sessions for housing, jobs, and benefits.</li>
      <li><strong>Nonprofit tech support</strong> — Free setup and security for small community organizations.</li>
    </ul>

    <div class="rounded-2xl bg-band p-6 text-on-fill">
      <h2 class="font-display text-xl font-semibold mb-2">How to donate</h2>
      <p class="text-sm opacity-90 mb-4">
        Base Impact is currently accepting donations. Your support helps us provide devices,
        internet service, digital skills training, and tech support to neighbors and small nonprofits.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://www.zeffy.com/en-US/peer-to-peer/50k-for-base-impact" target="_blank" rel="noreferrer"
          class="inline-flex min-h-11 items-center rounded-full bg-emerald-700 px-6 py-2 text-sm font-semibold text-white hover:bg-emerald-800 btn-pill">
          Donate Now
        </a>
        <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg border border-on-fill/30 px-5 py-2 text-sm font-semibold text-on-fill hover:bg-on-fill/10">
          Contact us to donate
        </a>
      </div>
      <p class="mt-3 text-xs text-on-fill/70">Secure donation through Zeffy. No fees — 100% goes to Base Impact.</p>
    </div>

    <p class="text-sm text-faint">
      Base Impact Inc. is a Florida nonprofit corporation. 501(c)(3) tax-exempt status is pending.
      Donations are not currently tax-deductible. Please consult your tax advisor.
    </p>
  </div>
</Base>
