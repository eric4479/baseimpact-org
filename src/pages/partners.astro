---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/region';

export const prerender = true;
---

<Base
  title={`Partner With Us — Register Your Nonprofit | ${SITE.shortName}`}
  description="Register your church, pantry, shelter, or small nonprofit in the Brevard referral network. We share digital tools and help with grant paperwork."
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-4 text-4xl font-bold text-slate-900 md:text-5xl dark:text-slate-100">
      Work with Base Impact
    </h1>
    <p class="mb-10 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      We share digital tools, help with grant paperwork, and send neighbors to partners who actually
      have capacity.
    </p>

    <div class="mb-12 grid gap-4 sm:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 dark:text-emerald-400">1</span>
        <h2 class="mt-4 text-xl font-bold text-slate-900 dark:text-slate-100">Pantries &amp; shelters</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">
          Post your hours and ask people to call first. Availability changes — a phone call beats a
          wasted trip.
        </p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 dark:text-emerald-400">2</span>
        <h2 class="mt-4 text-xl font-bold text-slate-900 dark:text-slate-100">Tiny teams (1–5 people)</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">
          Help with free nonprofit software, email security, and getting a simple website online.
        </p>
      </article>
    </div>

    <section class="mb-12 rounded-2xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-800 dark:bg-blue-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
        Our current partners
      </h2>
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        We volunteer and work alongside these organizations to help the community in their times of
        need.
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {['LifePointe Ministries', 'No One Hungry', 'Under the Bridge Ministries', 'Second Harvest Food Bank'].map((p) => (
          <li class="rounded-xl border border-slate-200 bg-white p-4 font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            {p}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
        Register your organization
      </h2>
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        Join the Brevard referral network. Listing is free, and it is the most useful thing a local
        organization can do for the people we point your way.
      </p>
      <a
        href="/submit"
        class="inline-block rounded-full bg-emerald-800 px-6 py-2.5 font-semibold text-white transition hover:bg-emerald-900"
      >
        Register your organization
      </a>
    </section>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Get in touch</h2>
      <p class="mb-3 text-slate-700 dark:text-slate-300">
        For partnership proposals, grant collaboration, or anything else:
      </p>
      <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <p class="font-semibold text-slate-800 dark:text-slate-200">Base Impact Inc.</p>
        <p class="text-slate-700 dark:text-slate-300">Scottsmoor, FL 32775 · Brevard County</p>
        <p class="text-slate-700 dark:text-slate-300">(321) 323-0999 · call or text · by appointment only</p>
        <p class="mt-2">
          <a href={`mailto:${SITE.email}?subject=Partnership%20with%20Base%20Impact`} class="font-semibold text-emerald-800 underline dark:text-emerald-400">
            {SITE.email}
          </a>
        </p>
      </div>
    </section>

    <p class="text-xs text-slate-600 dark:text-slate-300">{SITE.legalNotice}</p>
  </article>
</Base>
