---
import Base from '../layouts/Base.astro';
import { REGION, SITE } from '../config/region';
import { coverage, gaps, stats } from '../lib/resources';
import { resources } from '../data/resources';

export const prerender = true;

const s = stats();
const cov = coverage();
const gapList = gaps();
const partners = resources.filter((r) => r.verification.status === 'partner');
---

<Base
  title={`About Base Impact — Brevard County Resource Navigator`}
  description="Base Impact connects neighbors to verified resources, helps nonprofits modernize, and fills community gaps across Florida's Space Coast."
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-6 text-4xl font-bold text-slate-900 md:text-5xl dark:text-slate-100">About Base Impact</h1>

    <p class="mb-6 text-lg leading-relaxed text-slate-700 italic dark:text-slate-300">
      &ldquo;Our purpose is to cultivate human dignity, universal well-being, and community
      prosperity by guiding individuals to vital resources, empowering grassroots organizations, and
      teaching essential online information skills.&rdquo;
    </p>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">What we do</h2>
      <ul class="space-y-3 text-slate-700 dark:text-slate-300">
        <li class="flex gap-3">
          <span class="text-emerald-700" aria-hidden="true">✔</span>
          <span
            ><strong>Find help.</strong> We locate recovery, housing, employment, and basic-needs
            resources across {REGION.counties.join(', ')} counties.</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-emerald-700" aria-hidden="true">✔</span>
          <span
            ><strong>Verify what we find.</strong> Volunteers confirm details by phone and in person,
            then stamp each listing with the date it was last checked.</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-emerald-700" aria-hidden="true">✔</span>
          <span
            ><strong>Fill the gaps.</strong> When a service doesn't exist, we work with partners to
            stand one up — or point people to the nearest thing that does.</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-emerald-700" aria-hidden="true">✔</span>
          <span
            ><strong>Modernize local nonprofits.</strong> We provide technology, security, and
            fee-free fundraising infrastructure to grassroots organizations.</span
          >
        </li>
      </ul>
    </section>

    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-800 dark:bg-emerald-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">We partner with 211 — we don't replace it</h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        211 already maintains a statewide, staffed, verified resource database. Rebuilding it
        would waste money and rot faster than we could maintain it. Our job is the
        <strong>local, human layer</strong> on top: the neighborhood organizations, the
        volunteer-run pantry, the church that opens when it's cold — plus teaching people
        to use 211, SAMHSA, and FindTreatment.gov themselves.
      </p>
      <p class="mt-3">
        <a href="tel:211" class="font-semibold text-emerald-800 underline dark:text-emerald-300">Call 211</a> for
        the full county-wide picture. Use us for the local detail.
      </p>
    </div>

    <section class="mb-12 rounded-2xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-800 dark:bg-blue-950/40">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
        We don't take or hold your documents — ever
      </h2>
      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        No ID, SSN card, birth certificate, or any other personal document ever enters our
        hands. A volunteer can <strong>accompany</strong> you to the office; you hold your
        paperwork at all times. We help with the process — which form to fill, what to bring,
        how much it costs — not with your data.
      </p>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        This protects you from identity theft and us from a breach we'd never recover from.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Our partners</h2>
      <p class="mb-4 text-slate-600 dark:text-slate-300">
        We grow this list through the people we serve alongside.
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          partners.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <p class="font-semibold text-slate-800 dark:text-slate-200">{p.name}</p>
              <p class="text-sm text-slate-600 dark:text-slate-300">{p.orgType}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="gaps" class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Coverage &amp; gaps</h2>
      <p class="mb-4 text-slate-600 dark:text-slate-300">
        {s.total} listings tracked &middot; {s.trusted} human-verified &middot; {s.sample} placeholders
        awaiting replacement.
      </p>
      <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-600 dark:text-slate-300 dark:bg-slate-800">
            <tr>
              <th class="px-4 py-2 font-semibold">Category</th>
              <th class="px-4 py-2 font-semibold">Verified</th>
              <th class="px-4 py-2 font-semibold">Placeholders</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              cov.map((c) => (
                <tr>
                  <td class="px-4 py-2 text-slate-700 dark:text-slate-300">{c.label}</td>
                  <td
                    class={
                      c.trusted === 0 ? 'px-4 py-2 font-semibold text-amber-700 dark:text-amber-300' : 'px-4 py-2 text-emerald-700 dark:text-emerald-400'
                    }
                  >
                    {c.trusted}
                  </td>
                  <td class="px-4 py-2 text-slate-500 dark:text-slate-400">{c.sample}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {
        gapList.length > 0 && (
          <p class="mt-4 text-sm text-amber-800 dark:text-amber-300">
            <strong>Working to fill:</strong> {gapList.map((g) => g.label).join(', ')}.{' '}
            <a href="/submit" class="underline">Suggest a resource →</a>
          </p>
        )
      }
    </section>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">How we gather and check information</h2>
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        We collect listings from partner organizations, public websites, and word of mouth. Each one
        is confirmed before it appears, re-checked quarterly, and stamped with the date it was last
        verified. Anyone can submit a correction or a new resource through our
        <a href="/submit" class="underline">feedback form</a> — we improve the process as we learn.
      </p>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-relaxed text-amber-900 dark:border-amber-800 dark:text-amber-200 dark:bg-amber-950/40">
        <p class="mb-2 font-bold">Our commitments</p>
        <ul class="list-disc space-y-1 pl-5">
          <li>Listed does <strong>not</strong> mean endorsed.</li>
          <li>We never give medical or legal advice, and never recommend a level of care.</li>
          <li>
            We accept <strong>no compensation</strong> for any listing or referral — including any
            treatment provider or recovery residence (Fla. Stat. § 817.505).
          </li>
          <li>No advertising or tracking on these pages.</li>
          <li>We do not sell or share what you tell us.</li>
        </ul>
      </div>
    </section>

    <!-- Founder -->
    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Our Founder</h2>
      <div class="flex flex-col gap-6 sm:flex-row">
        <img
          src="/eric-douglas.png"
          alt="Eric Douglas, Founder and President of Base Impact"
          class="h-48 w-48 flex-shrink-0 rounded-2xl border border-slate-200 object-cover dark:border-slate-700"
          loading="lazy"
        />
        <div>
          <p class="mb-2 text-lg font-semibold text-slate-800 dark:text-slate-200">Eric Douglas</p>
          <p class="mb-3 text-sm font-medium text-emerald-700 dark:text-emerald-400">Founder &amp; President</p>
          <p class="leading-relaxed text-slate-700 dark:text-slate-300">
            Eric has spent his life working with computers and technology, running Douglas PC tech
            support in Mims, FL. Base Impact is the nonprofit he's building to take that same
            instinct — show up, fix what's broken, help the person in front of you — and apply it
            to the bigger need he sees in our community.
          </p>
          <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-300">
            He's spent years helping people one-on-one — fixing laptops, setting Wi-Fi for
            churches, walking someone through a job application. Base Impact is his attempt to
            build that neighborhood navigation desk.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section>
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">Contact</h2>
      <p class="text-slate-700 dark:text-slate-300">
        <a href={`mailto:${SITE.email}`} class="font-semibold text-emerald-700 underline dark:text-emerald-400"
          >{SITE.email}</a
        >
      </p>
      <p class="mt-6 text-xs text-slate-500 dark:text-slate-400">{SITE.legalNotice}</p>
    </section>
  </article>
</Base>
