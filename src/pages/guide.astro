---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/region';

export const prerender = true;

const helplines = [
  {
    label: '211',
    href: 'tel:211',
    handles: 'Food, shelter beds, utilities, transit, everything local',
    detail: 'Open 24/7. They keep the current list of who is open, who has a bed tonight, and who has food.',
  },
  {
    label: '988',
    href: 'tel:988',
    handles: 'Mental health, crisis, and suicidal thoughts',
    detail: 'Suicide & Crisis Lifeline. Call or text, 24/7. Free and confidential.',
  },
  {
    label: 'Base Impact',
    href: `mailto:${SITE.email}?subject=Help%20finding%20resources`,
    handles: "Help making the calls and understanding what you're offered",
    detail: 'By appointment — call or text first. We can help with a phone, a map, and a call.',
  },
];

const situations = [
  {
    title: 'I need food now',
    providers: [
      { label: 'Mims United Methodist Church Food Pantry', detail: 'Tuesdays 10 AM–12 PM, or until food runs out — 3302 Green St, Mims. Closest pantry to Scottsmoor, no requirements.' },
      { label: 'United North Brevard Food Pantry', detail: 'Tuesdays & Fridays 11 AM–3 PM — 412 Main St, Titusville. Choice pantry with fresh produce.' },
      { label: 'No One Hungry — Pine St Pantry', detail: 'Tuesdays 10 AM–12 PM — 418 Pine St, Titusville. Bring ID or proof of Brevard County residency.' },
    ],
    note: 'Out of hours? The numbers above know who else is open today.',
  },
  {
    title: 'I need a place to stay tonight',
    providers: [],
    note: 'Shelter beds change daily and are not listed here — 211 holds the current list. If you are in immediate danger, use 911.',
  },
  {
    title: "I'm traveling and stranded",
    providers: [
      { label: 'Florida Road Rangers — dial *347', href: 'tel:*347', detail: 'Free roadside help on Florida highways, 24/7: flat tires, jump starts, emergency gas and water. Funded by FDOT — no charge to you.' },
      { label: 'Florida 511', href: 'https://fl511.com', detail: 'Live crashes, closures, and backups on Florida roads. Free, 24/7.' },
      { label: 'Halifax Urban Ministries — Hope Place', detail: 'Daytona Beach, serving Volusia and Flagler. A Travelers Aid International member.' },
    ],
    note: 'Dial *347 from a mobile phone — it will not work from a landline. If a crash has hurt someone, use 911.',
  },
  {
    title: 'I need a computer or help with a job application',
    providers: [],
    note: 'Base Impact can sit with you — housing portal walk-throughs and job applications, by appointment.',
  },
  {
    title: "I'm part of a church or small nonprofit and want to partner",
    providers: [{ label: 'Register your organization', href: '/partners', detail: 'Pantries, shelters, churches, trainers, tiny teams — no nonprofit experience required.' }],
  },
  {
    title: "I'm looking for care packages, clothing, or hygiene kits",
    providers: [{ label: 'Check the directory', href: '/#resources', detail: 'For current locations offering these. Hours change often, so call before you go.' }],
  },
  {
    title: 'I need mental health or disability support',
    providers: [],
    note: 'For disability and benefits questions, the numbers above can route you to county and community programs.',
  },
  {
    title: "I don't see my situation here",
    providers: [],
    note: "The numbers above cover far more than we do. You can also contact us and we'll point you the right direction.",
  },
];

const directories = [
  { label: 'SAMHSA Treatment Locator', url: 'https://findtreatment.samhsa.gov', desc: 'Mental health and substance use resources' },
  { label: 'Florida DCF', url: 'https://www.myflorida.com/accessflorida/', desc: 'SNAP, TANF, and state assistance programs' },
  { label: 'Brevard County', url: 'https://www.brevardfl.gov/', desc: 'County services and programs' },
  { label: 'Feeding Florida', url: 'https://feedingflorida.org', desc: 'State food bank network' },
];
---

<Base
  title={`Resource guide — ${SITE.name}`}
  description="Pick your situation and we'll point you to food, shelter, and help across Florida's Space Coast."
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-4 text-4xl font-bold text-slate-900 md:text-5xl dark:text-slate-100">
      Not sure where to start? Pick your situation.
    </h1>
    <p class="mb-10 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      No sign-up. No judgment. Pick what fits and we'll point you to the right place.
    </p>

    <section class="mb-12">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
        Three numbers cover most of it.
      </h2>
      <p class="mb-5 text-slate-700 dark:text-slate-300">
        Whatever you picked below, these work.
      </p>
      <ul class="grid gap-4 sm:grid-cols-2">
        {helplines.map((h) => (
          <li class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-800 dark:bg-emerald-950/40">
            <a href={h.href} class="font-semibold text-emerald-800 underline dark:text-emerald-300">{h.label} →</a>
            <p class="mt-2 text-sm font-medium text-slate-800 dark:text-slate-200">{h.handles}</p>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">{h.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-2xl font-bold text-slate-900 dark:text-slate-100">
        What's going on right now?
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {situations.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="font-semibold text-slate-800 dark:text-slate-200">{s.title}</h3>
            {s.providers.length > 0 && (
              <ul class="mt-3 space-y-2">
                {s.providers.map((p) => (
                  <li>
                    {p.href ? (
                      <a href={p.href} class="text-sm font-semibold text-emerald-700 underline dark:text-emerald-400">{p.label} →</a>
                    ) : (
                      <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{p.label}</span>
                    )}
                    <p class="text-xs text-slate-600 dark:text-slate-400">{p.detail}</p>
                  </li>
                ))}
              </ul>
            )}
            {s.note && <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{s.note}</p>}
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
        Other resource directories worth knowing
      </h2>
      <p class="mb-4 text-slate-700 dark:text-slate-300">
        These national and state directories cover broader areas — useful if our local directory
        doesn't have what you need.
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {directories.map((d) => (
          <li>
            <a
              href={d.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-emerald-700 transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-800 dark:text-emerald-400"
            >
              {d.label} →
              <span class="block text-xs font-normal text-slate-600 dark:text-slate-400">{d.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>
