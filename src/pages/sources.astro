---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/region';
import { resources } from '../data/resources';
import { CATEGORY_META, type Category } from '../data/schema';

// Public sources page. For every listing we publish where we read it and when.
// This is the trust signal: it makes our accuracy disclaimer credible instead of
// defensive, and it answers "where did this come from?" without anyone having to ask.

const withSource = resources.filter((r) => r.verification?.source);
const withoutSource = resources.filter((r) => !r.verification?.source);

const byCategory = new Map<Category, typeof resources>();
for (const r of withSource) {
  if (!byCategory.has(r.category)) byCategory.set(r.category, [] as unknown as typeof resources);
  byCategory.get(r.category)!.push(r);
}

function prettySource(src: string): string {
  if (/^https?:\/\//.test(src)) {
    try {
      return new URL(src).hostname.replace(/^www\./, '');
    } catch {
      return src;
    }
  }
  return src;
}
---

<Base
  title={`Where our listings come from | ${SITE.shortName}`}
  description="Every listing in the Base Impact resource guide, with the source we read it from and the date we read it. Transparency about where our information comes from."
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-4 text-4xl font-bold text-slate-900 dark:text-slate-100">
      Where our listings come from
    </h1>

    <p class="mb-6 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Every listing here is compiled from a source we can point to — an organization&rsquo;s own
      website, a public Facebook page, or a government program page. Below is where each one came
      from and the date we read it.
    </p>

    <div class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-relaxed text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
      <p class="mb-2 font-bold text-slate-900 dark:text-slate-100">What this page does and does not mean</p>
      <p class="mb-2">
        <strong>It means:</strong> we read this information from the source shown, on the date shown.
      </p>
      <p>
        <strong>It does not mean</strong> we called, visited, or inspected the organization, or that
        its hours, eligibility, or cost are accurate today. <strong>Always call ahead.</strong>
      </p>
    </div>

    <p class="mb-8 text-sm text-slate-600 dark:text-slate-300">
      <strong>{resources.length}</strong> listings total &middot;
      <strong>{withSource.length}</strong> with a recorded source
      {withoutSource.length > 0 && (
        <>
          {' '}&middot; <strong>{withoutSource.length}</strong> awaiting a source (shown at the end)
        </>
      )}
    </p>

    {[...byCategory.entries()].map(([cat, items]) => (
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-slate-100">
          {CATEGORY_META[cat]?.label ?? cat}
          <span class="ml-2 text-sm font-normal text-slate-500 dark:text-slate-400">
            ({items.length})
          </span>
        </h2>
        <ul class="space-y-3">
          {items.map((r) => (
            <li class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <p class="font-semibold text-slate-900 dark:text-slate-100">{r.name}</p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                Source:{' '}
                {/^https?:\/\//.test(r.verification.source!) ? (
                  <a
                    href={r.verification.source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-emerald-800 dark:hover:text-emerald-400"
                  >
                    {prettySource(r.verification.source!)}
                  </a>
                ) : (
                  <span>{r.verification.source}</span>
                )}
                {r.verification.lastVerified && (
                  <span class="text-slate-500 dark:text-slate-400">
                    {' '}&middot; read {r.verification.lastVerified}
                  </span>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {withoutSource.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-slate-100">
          Awaiting a recorded source
          <span class="ml-2 text-sm font-normal text-slate-500 dark:text-slate-400">
            ({withoutSource.length})
          </span>
        </h2>
        <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">
          These listings are published by the organization or a government agency, but we have not
          yet recorded the exact page we read them from. We are working through them. If you spot
          one you can help with, please <a href="/submit" class="underline">tell us</a>.
        </p>
        <ul class="grid gap-2 sm:grid-cols-2">
          {withoutSource.map((r) => (
            <li class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 dark:border-slate-700 dark:text-slate-300">
              {r.name}
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-sm leading-relaxed text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200">
      <p class="mb-1 font-bold">Want your organization removed or corrected?</p>
      <p>
        <a href="/removal" class="font-semibold underline">Request removal</a> — no reason required,
        we take it down. Or <a href="/submit" class="font-semibold underline">send a correction</a>
        and we will fix it from your own website.
      </p>
    </div>
  </article>
</Base>
