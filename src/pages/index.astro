---
import Base from '../layouts/Base.astro';
import ResourceExplorer from '../components/ResourceExplorer.astro';
import { LISTING_DISCLAIMER, REGION, SITE } from '../config/region';
import { coverage, gaps, stats } from '../lib/resources';

export const prerender = true;

const s = stats();
const gapList = gaps();
const cov = coverage();
---

<Base>
  <!-- Hero -->
  <header class="px-4 pt-12 pb-10">
    <div class="mx-auto max-w-4xl text-center">
      <span
        class="mb-5 inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold tracking-widest text-emerald-800 uppercase dark:text-emerald-300 dark:bg-emerald-900/50"
      >
        Free · Local · Brevard County
      </span>
      <h1 class="mb-5 text-4xl leading-tight font-bold text-slate-900 md:text-6xl dark:text-slate-100">
        Technology help for people and nonprofits in Brevard County
      </h1>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        We help neighbors get devices, internet, and the skills to use them — and we set up
        technology free for small local nonprofits, churches, and food pantries. Plus a plain-language
        guide to food, shelter, recovery, and jobs in Brevard County.
      </p>
      <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">
        Serving {REGION.label} — {REGION.counties.join(' · ')} counties
      </p>
    </div>
  </header>

  <!-- The hub -->
  <ResourceExplorer />

  <!-- How it works -->
  <section id="how" class="border-t border-slate-200 bg-white py-16 dark:border-slate-700 dark:bg-slate-800">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-3 text-center text-3xl font-bold text-slate-900 md:text-4xl dark:text-slate-100">
        How we build the list — and what we promise
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center text-slate-600 dark:text-slate-300">
        We compile listings from public sources and community word of mouth. We tell you
        to call ahead. We never claim more than that.
      </p>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800">
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:text-emerald-400 dark:bg-emerald-900/50"
          >
            1
          </div>
          <h3 class="mb-2 font-bold text-slate-800 dark:text-slate-200">Where our listings come from</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Official websites, public Facebook pages, government program pages, and what
            neighbors and partner organizations tell us. We read the source; we do not
            inspect or call every location.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800">
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:text-emerald-400 dark:bg-emerald-900/50"
          >
            2
          </div>
          <h3 class="mb-2 font-bold text-slate-800 dark:text-slate-200">Always call ahead</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Hours, eligibility, and availability change without notice. Treat every listing
            as a starting point, not a guarantee. For the full county-wide picture, call{" "}
            <a href="tel:211" class="font-semibold underline">211</a>.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800">
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:text-emerald-400 dark:bg-emerald-900/50"
          >
            3
          </div>
          <h3 class="mb-2 font-bold text-slate-800 dark:text-slate-200">We never take money to list</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            No provider pays to appear or to rank higher. Listed does not mean endorsed —
            you decide what fits.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800">
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 font-bold text-emerald-800 dark:text-emerald-400 dark:bg-emerald-900/50"
          >
            4
          </div>
          <h3 class="mb-2 font-bold text-slate-800 dark:text-slate-200">We never hold your documents</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            We never take custody of your ID, SSN card, or birth certificate. You hold
            your paperwork at all times — we help with the process, not the data.
          </p>
        </div>
      </div>

      <!-- Live coverage snapshot -->
      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <h3 class="mb-1 text-lg font-bold text-slate-800 dark:text-slate-200">Current coverage</h3>
        <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">
          {s.trusted} listings across {s.categories} categories.
          {s.sample > 0 && (
            <>
              {' '}
              <strong class="text-amber-700">{s.sample} are placeholders</strong> we are actively
              replacing.
            </>
          )}
        </p>
        <ul class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          {
            cov.map((c) => (
              <li class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800">
                <span class="text-slate-700 dark:text-slate-300">{c.label}</span>
                <span
                  class={c.trusted === 0 ? 'font-semibold text-amber-700 dark:text-amber-300' : 'font-semibold text-emerald-800 dark:text-emerald-400'}
                >
                  {c.trusted} listed
                </span>
              </li>
            ))
          }
        </ul>
        {gapList.length > 0 && (
          <p class="mt-4 text-sm text-amber-900 dark:text-amber-300">
            <strong>Gaps we are working to fill:</strong>{' '}
            {gapList.map((g) => g.label).join(', ')}.
            <a href="/submit" class="underline">Know a resource?</a>
          </p>
        )}
      </div>

      <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-relaxed text-amber-900 dark:border-amber-800 dark:text-amber-200 dark:bg-amber-950/40">
        <p class="mb-1 font-bold">Please read</p>
        <p>{LISTING_DISCLAIMER}</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-900 py-16 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-4 text-3xl font-bold">Know a resource we're missing?</h2>
      <p class="mb-8 leading-relaxed text-slate-300">
        Help us keep this accurate. Suggest a local organization, or report a number that no longer
        works.
      </p>
      <a
        href="/submit"
        class="inline-block rounded-full bg-emerald-800 px-8 py-3 font-bold text-white shadow-lg transition hover:bg-emerald-500"
      >
        Suggest a resource
      </a>
      <p class="mt-6 text-xs text-slate-400">
        We never sell or share the information you give us here. &bull;
        <a href={`mailto:${SITE.email}`} class="underline">{SITE.email}</a>
      </p>
    </div>
  </section>
</Base>
