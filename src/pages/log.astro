---
import Base from '../layouts/Base.astro';
---

<Base title="Messages — Base Impact" description="Updates and messages from Base Impact.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Messages</h1>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed">
    <p>Updates and announcements from Base Impact will appear here.</p>
    <p class="text-sm text-muted">Check back soon for the latest news.</p>
  </div>
</Base>
