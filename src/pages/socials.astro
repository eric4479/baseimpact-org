---
import Base from '../layouts/Base.astro';
---

<Base title="Socials — Base Impact" description="Follow Base Impact on social media for updates on resources, events, and community help in Brevard County, FL.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Socials</h1>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed">
    <p>Follow Base Impact for updates on new resources, events, and opportunities to get involved.</p>
    <h2 class="font-display text-xl font-semibold text-body mt-6">Coming soon</h2>
    <p>We're setting up our social media presence. Check back soon for links to follow us.</p>
    <p>In the meantime, <a href="/contact" class="text-accent font-semibold">contact us</a> directly or call <a href="tel:+13213230999" class="text-accent font-semibold">(321) 323-0999</a>.</p>
  </div>
</Base>
