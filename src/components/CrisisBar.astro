---
import { CRISIS_LINES } from '../config/region';
---

<!--
  Pinned to the top of EVERY page. Base Impact is a router, not a crisis service.
  These must never be more than one tap away. Do not remove.
-->
<div class="no-print bg-red-800 text-white" role="region" aria-label="Crisis helplines">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-2 text-center text-sm"
  >
    <span class="font-bold tracking-wide">In crisis right now?</span>
    {
      CRISIS_LINES.map((line, i) => (
        <span class="inline-flex items-center gap-x-4">
          <a
            href={`tel:${line.tel}`}
            class="font-semibold underline hover:no-underline"
            aria-label={`${line.label} — ${line.note}`}
          >
            {line.display}
            <span class="font-normal opacity-90">· {line.note}</span>
          </a>
          {i < CRISIS_LINES.length - 1 && (
            <span class="hidden opacity-40 sm:inline" aria-hidden="true">
              •
            </span>
          )}
        </span>
      ))
    }
  </div>
</div>
