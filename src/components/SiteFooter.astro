---
import { REGION, SITE } from '../config/region';
const year = new Date().getFullYear();
---

<footer class="bg-slate-950 py-12 text-center text-sm text-slate-400">
  <div class="mx-auto max-w-7xl space-y-4 px-4">
    <p class="font-bold text-slate-300">{SITE.name} &bull; {SITE.domain}</p>

    <p class="mx-auto max-w-2xl text-sm leading-relaxed">
      Serving {REGION.counties.join(' · ')} counties — {REGION.label}.
    </p>

    <p class="mx-auto max-w-3xl text-sm leading-relaxed">
      Listings are informational only and are <strong class="text-slate-400">not endorsements</strong
      >. Base Impact is a navigator, not a provider, and accepts
      <strong class="text-slate-400">no compensation</strong> for any listing or referral — including
      any treatment provider or recovery residence (Fla. Stat. § 817.505).
    </p>

    <p class="mx-auto max-w-2xl text-sm text-slate-400 dark:text-slate-300">{SITE.legalNotice}</p>

    <p class="mx-auto max-w-2xl text-sm text-slate-400 dark:text-slate-300">
      EIN: 43-2200667 &middot; Florida Solicitation of Contributions Registration #: CH85670
    </p>

    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-slate-400 dark:text-slate-300">
      <a href="/guide" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Resource Guide</a>
      <a href="/partners" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Partners</a>
      <a href="/volunteer" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Volunteer</a>
      <a href="/lifeline" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Lifeline</a>
      <a href="/grants" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Grants &amp; Funding</a>
      <a href="/submit" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Suggest a Resource</a>
      <a href="/terms" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Terms &amp; Disclaimer</a>
      <a href="/sources" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Where Our Listings Come From</a>
      <a href="/removal" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Request Removal</a>
      <a href="/privacy" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Privacy Policy</a>
      <a href="/donate" class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">Donate</a>
      <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center px-1 underline hover:text-slate-400">{SITE.email}</a>
    </nav>

    <p class="text-xs text-slate-400 dark:text-slate-300">
      &copy; {year} {SITE.name} All rights reserved.
    </p>
  </div>
</footer>
