---
import { SITE } from '../config/region';

const nav = [
  { href: '/#resources', label: 'Find Help' },
  { href: '/guide', label: 'Guide' },
  { href: '/partners', label: 'Partners' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/about', label: 'About' },
  { href: '/donate', label: 'Donate' },
];
const path = Astro.url.pathname;
---

<header class="no-print sticky top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-md dark:border-slate-700 dark:bg-slate-900/85">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/logo.png"
          alt=""
          width="36"
          height="36"
          class="h-9 w-9 rounded-lg shadow-sm"
          aria-hidden="true"
        />
        <span class="flex flex-col">
          <span class="text-xl leading-none font-bold tracking-tight text-slate-800 dark:text-slate-100 dark:text-slate-200">{SITE.name}</span>
          <span class="mt-1 text-[10px] font-semibold tracking-wider text-emerald-700 uppercase dark:text-emerald-400"
            >{SITE.domain}</span
          >
        </span>
      </a>

      <nav class="hidden items-center gap-7 text-sm font-medium md:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={
                item.href === path
                  ? 'text-emerald-700 dark:text-emerald-400'
                  : 'text-slate-600 transition hover:text-emerald-700 dark:text-slate-300 dark:hover:text-emerald-400'
              }
            >
              {item.label}
            </a>
          ))
        }
        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Switch to dark theme"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 bg-white text-lg transition hover:border-emerald-500 hover:text-emerald-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-emerald-400 dark:hover:text-emerald-400"
          title="Toggle theme"
        >
          <span data-theme-icon aria-hidden="true">☽</span>
          <span data-theme-label class="sr-only">Switch to dark theme</span>
        </button>
        <a
          href="/#resources"
          class="rounded-full bg-emerald-700 px-4 py-2 text-white transition hover:bg-emerald-800"
        >
          Find Help
        </a>
      </nav>

      <a href="/#resources" class="text-sm font-semibold text-emerald-700 md:hidden dark:text-emerald-400">Find Help</a>
    </div>
  </div>
</header>

<script is:inline>
  function toggleTheme() {
    var html = document.documentElement;
    var current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    var next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    html.style.colorScheme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
      var label = btn.querySelector('[data-theme-label]');
      if (label) label.textContent = next === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
      var icon = btn.querySelector('[data-theme-icon]');
      if (icon) icon.textContent = next === 'dark' ? '☀' : '☽';
    });
  }
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', toggleTheme);
    });
  });
</script>
