---
import { CATEGORY_META, POPULATION_LABELS, type Resource } from '../data/schema';

interface Props {
  resource: Resource;
}
const { resource: r } = Astro.props;

const meta = CATEGORY_META[r.category];
const status = r.verification.status;
const tel = r.phone ? r.phone.replace(/[^0-9+]/g, '') : undefined;

// Badges are operational only. There is deliberately NO "verified" badge and NO
// verification date: we compile listings from public sources (official websites,
// Facebook pages, community word of mouth) and do not claim to have inspected or
// called each one. The standing advice is always "call ahead" — see below.
let badge: { cls: string; text: string } | null = null;
if (status === 'sample') {
  badge = { cls: 'bg-amber-100 text-amber-900 border-amber-300', text: 'SAMPLE — replace' };
} else if (status === 'closed') {
  badge = { cls: 'bg-slate-200 text-slate-700 border-slate-300', text: 'Closed' };
}

const rows: Array<{ icon: string; label: string; value: string }> = [];
if (r.city) rows.push({ icon: '📍', label: 'Location', value: r.address ?? r.city });
else if (r.address) rows.push({ icon: '📍', label: 'Location', value: r.address });
if (r.hours) rows.push({ icon: '🕑', label: 'Hours', value: r.hours });
if (r.cost?.length) rows.push({ icon: '💲', label: 'Cost', value: r.cost.join(' · ') });
if (r.eligibility) rows.push({ icon: '👤', label: 'Who qualifies', value: r.eligibility });
if (r.walkIn) rows.push({ icon: '🚪', label: 'Walk-in', value: 'Walk-ins welcome' });
if (r.languages?.length) rows.push({ icon: '🗣', label: 'Languages', value: r.languages.join(' · ') });
if (r.licenseNumber) {
  rows.push({
    icon: '📋',
    label: 'License',
    value: `${r.licenseNumber}${r.licensingAuthority ? ` (${r.licensingAuthority})` : ''}`,
  });
}
if (r.population?.length) {
  rows.push({
    icon: '👥',
    label: 'Serves',
    value: r.population.map((p) => POPULATION_LABELS[p] ?? p).join(' · '),
  });
}
if (r.address) {
  rows.push({ icon: '🚌', label: 'Transit', value: 'Check bus route before traveling' });
}
---

<article
  id={r.id}
  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
>
  <div class="mb-3 flex items-start justify-between gap-3">
    <span
      class={`rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wider uppercase ${meta.badge}`}
      >{meta.label}</span
    >
    {
      badge && (
        <span class={`rounded-full border px-2 py-0.5 text-[11px] font-semibold ${badge.cls}`}>
          {badge.text}
        </span>
      )
    }
  </div>

  <h3 class="mb-1 text-lg leading-snug font-bold text-slate-900 dark:text-slate-100">{r.name}</h3>
  <p class="mb-3 text-sm font-medium text-emerald-800 dark:text-emerald-400">{r.orgType}</p>

  <dl class="mb-4 flex-1 space-y-1.5 text-sm text-slate-600 dark:text-slate-300">
    {
      rows.map((row) => (
        <div class="flex gap-2">
          <dt class="sr-only">{row.label}</dt>
          <span aria-hidden="true">{row.icon}</span>
          <dd>{row.value}</dd>
        </div>
      ))
    }
    {
      rows.length === 0 && (
        <div class="flex gap-2">
          <span aria-hidden="true">📍</span>
          <dd class="text-slate-600 dark:text-slate-300">Details not listed — call ahead</dd>
        </div>
      )
    }
  </dl>

  {
    tel ? (
      <a
        href={`tel:${tel}`}
        class="mt-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 font-semibold text-white transition hover:bg-emerald-900"
      >
        <span aria-hidden="true">📞</span> {r.phone}
      </a>
    ) : (
      <p class="mt-auto rounded-xl bg-slate-50 px-4 py-2.5 text-center text-sm text-slate-600 dark:text-slate-300 dark:bg-slate-800">
        No phone listed — see website
      </p>
    )
  }

  {
    r.website && (
      <a
        href={r.website}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 text-center text-xs text-slate-600 underline hover:text-emerald-800 dark:text-slate-300"
      >
        {r.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
      </a>
    )
  }
  <p class="mt-3 text-xs text-slate-600 dark:text-slate-300">
    Call ahead — hours and availability change. Listed does not mean endorsed.
  </p>
</article>
